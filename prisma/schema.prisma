generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bounties {
  id               Int
  chain_id         Int
  title            String
  description      String
  amount           String
  amount_sort      Float    @db.Real
  issuer           String
  in_progress      Boolean? @default(true)
  is_joined_bounty Boolean? @default(false)
  is_canceled      Boolean? @default(false)
  is_multiplayer   Boolean?
  is_voting        Boolean? @default(false)
  deadline         Int?

  claims         Claims[]
  participations ParticipationsBounties[]
  issuerUser     Users?                   @relation(fields: [issuer], references: [address])
  ban            Ban[]
  transactions   Transactions[]

  @@id([id, chain_id], map: "Bounties_id_chain_id_pk")
}

model BountiesExtra {
  bounty_id Int
  chain_id  Int
  album     String?

  @@id([bounty_id, chain_id])
}

model Claims {
  id          Int
  chain_id    Int
  title       String
  description String
  url         String
  issuer      String
  is_accepted Boolean? @default(false)
  bounty_id   Int
  owner       String

  bounty     Bounties? @relation(fields: [bounty_id, chain_id], references: [id, chain_id])
  issuerUser Users?    @relation(fields: [issuer], references: [address])
  ban        Ban[]

  @@id([id, chain_id], map: "Claims_id_chain_id_pk")
}

model ParticipationsBounties {
  user_address String
  bounty_id    Int
  chain_id     Int
  amount       String

  bounty Bounties? @relation(fields: [bounty_id, chain_id], references: [id, chain_id])
  user   Users?    @relation(fields: [user_address], references: [address])

  @@id([user_address, bounty_id, chain_id], map: "ParticipationsBounties_user_address_bounty_id_chain_id_pk")
}

model Users {
  address   String
  twitter   String?
  farcaster String?

  participations ParticipationsBounties[]
  claims         Claims[]
  bounties       Bounties[]

  @@id([address], map: "Users_address_pk")
}

model Ban {
  id        Int       @id @default(autoincrement())
  chain_id  Int
  bounty_id Int?
  banned_by String
  banned_at DateTime? @default(now()) @db.Timestamp(6)
  claim_id  Int?

  bounty Bounties? @relation(fields: [bounty_id, chain_id], references: [id, chain_id])
  claim  Claims?   @relation(fields: [claim_id, chain_id], references: [id, chain_id])

  @@index([bounty_id], map: "idx_bounty_id")
  @@index([claim_id], map: "idx_claim_id")
}

model Transactions {
  tx        String
  index     Int
  bounty_id Int
  chain_id  Int
  address   String
  action    String
  timestamp Decimal @db.Decimal(78, 0)

  bounty Bounties? @relation(fields: [bounty_id, chain_id], references: [id, chain_id])

  @@id([tx, index, chain_id], map: "Transactions_tx_index_chain_id_pk")
}

model Leaderboard {
  address  String
  chain_id Int
  earned   Float? @default(0) @db.Real
  paid     Float? @default(0) @db.Real
  nfts     Float? @default(0) @db.Real

  @@id([address, chain_id], map: "Leaderboard_address_chain_id_pk")
}

model ponder_checkpoint {
  chain_name        String @id
  chain_id          BigInt
  safe_checkpoint   String @db.VarChar(75)
  latest_checkpoint String @db.VarChar(75)

  @@map("_ponder_checkpoint")
}

model ponder_meta {
  key   String @id
  value Json

  @@map("_ponder_meta")
}

model reorg__Bounties {
  id               Int
  chain_id         Int
  title            String
  description      String
  amount           String
  amount_sort      Float    @db.Real
  issuer           String
  in_progress      Boolean? @default(true)
  is_joined_bounty Boolean? @default(false)
  is_canceled      Boolean? @default(false)
  is_multiplayer   Boolean?
  is_voting        Boolean? @default(false)
  deadline         Int?
  operation_id     Int      @id @default(autoincrement())
  operation        Int
  checkpoint       String   @db.VarChar(75)

  @@map("_reorg__Bounties")
}

model reorg__Claims {
  id           Int
  chain_id     Int
  title        String
  description  String
  url          String
  issuer       String
  is_accepted  Boolean? @default(false)
  bounty_id    Int
  owner        String
  operation_id Int      @id @default(autoincrement())
  operation    Int
  checkpoint   String   @db.VarChar(75)

  @@map("_reorg__Claims")
}

model reorg__Leaderboard {
  address      String
  chain_id     Int
  earned       Float? @default(0) @db.Real
  paid         Float? @default(0) @db.Real
  nfts         Float? @default(0) @db.Real
  operation_id Int    @id @default(autoincrement())
  operation    Int
  checkpoint   String @db.VarChar(75)

  @@map("_reorg__Leaderboard")
}

model reorg__ParticipationsBounties {
  user_address String
  bounty_id    Int
  chain_id     Int
  amount       String
  operation_id Int    @id @default(autoincrement())
  operation    Int
  checkpoint   String @db.VarChar(75)

  @@map("_reorg__ParticipationsBounties")
}

model reorg__Transactions {
  tx           String
  index        Int
  bounty_id    Int
  chain_id     Int
  address      String
  action       String
  timestamp    Decimal @db.Decimal(78, 0)
  operation_id Int     @id @default(autoincrement())
  operation    Int
  checkpoint   String  @db.VarChar(75)

  @@map("_reorg__Transactions")
}

model reorg__Users {
  address      String
  operation_id Int    @id @default(autoincrement())
  operation    Int
  checkpoint   String @db.VarChar(75)

  @@map("_reorg__Users")
}

model migrations {
  version    BigInt   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}
